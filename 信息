return function(Window, WindUI)
    local tab = Window:Tab({Title = "信息", Icon = "info"})

    local serverSection = tab:Section({Title = "支持的服务器列表", Collapsible = true, Box = true})

    local serverList = {
        "画我",
        "扔出一枚硬币",
        "踢一个幸运方块",
        "极速传奇",
        "自然灾害",
        "巴掌模拟器",
        "合并一个核弹",
        "鸡场",
        "+1斧头挥动逃脱",
        "+1键盘速度逃脱",
        "将球踢向太空",
        "每次点击速度+1",
        "逃离海啸",
        "用脑冲击波击中一个幸运方块"
    }

    for _, name in ipairs(serverList) do
        serverSection:Label({Title = name})
    end

    return tab
end
