-- 黑洞 Tab 模块
-- 用法（在主脚本 hygg.lua 中）：
--   local loadBlackholeTab = loadstring(game:HttpGet("https://你的仓库地址/blackhole_tab.lua"))()
--   loadBlackholeTab(Window, WindUI)
--
-- 这个模块会创建"黑洞"Tab，内含一个下拉选择器（黑洞1/黑洞2）和一个总开关。
-- 两个黑洞互斥（同时只能开一个），各自的悬浮窗仍由 5.txt / 9.txt 各自独立生成。

return function(Window, WindUI)

local blackholeTab = Window:Tab({Title = "黑洞", Icon = "circle"})

local bhConfig = {radius = 50, height = 100, speed = 10, strength = 1000}
local bh2Config = {radius = 50, height = 100, speed = 10, strength = 1000}
local bhRunning = false
local bh2Running = false
local bhApi = nil
local bh2Api = nil
local selectedBlackhole = "黑洞1"
local bhToggleControl = nil

-- 黑洞1：加载/启动（各自独立窗口，由5.txt自身生成）
local function startBlackhole1()
if not bhApi then
local success = pcall(function()
loadstring(game:HttpGet("https://hygg3795-debug.github.io/111/5.txt"))()
end)
if success then
bhApi = getgenv().RingControl
end
end
if bhApi then
bhApi:setRadius(bhConfig.radius)
bhApi:setHeight(bhConfig.height)
bhApi:setSpeed(bhConfig.speed)
bhApi:setStrength(bhConfig.strength)
bhApi:start()
bhRunning = true
WindUI:Notify({Title = "黑洞1", Content = "已开启", Duration = 2, Icon = "check"})
end
end

local function stopBlackhole1(silent)
if bhApi then pcall(function() bhApi:stop() end) end
bhRunning = false
if not silent then
WindUI:Notify({Title = "黑洞1", Content = "已关闭", Duration = 2, Icon = "x"})
end
end

-- 黑洞2：加载/启动（各自独立窗口，由9.txt自身生成）
local function startBlackhole2()
if not bh2Api then
local success = pcall(function()
loadstring(game:HttpGet("https://hygg3795-debug.github.io/111/9.txt"))()
end)
if success then
bh2Api = getgenv().RingControl2
end
end
if bh2Api then
bh2Api:setRadius(bh2Config.radius)
bh2Api:setHeight(bh2Config.height)
bh2Api:setSpeed(bh2Config.speed)
bh2Api:setStrength(bh2Config.strength)
bh2Api:start()
bh2Running = true
WindUI:Notify({Title = "黑洞2", Content = "已开启", Duration = 2, Icon = "check"})
end
end

local function stopBlackhole2(silent)
if bh2Api then pcall(function() bh2Api:stop() end) end
bh2Running = false
if not silent then
WindUI:Notify({Title = "黑洞2", Content = "已关闭", Duration = 2, Icon = "x"})
end
end

-- 统一开关：只启动当前选择的黑洞，且互斥（开一个自动关另一个）
local function toggleBlackhole(val)
if val then
if selectedBlackhole == "黑洞1" then
if bh2Running then stopBlackhole2(true) end
startBlackhole1()
else
if bhRunning then stopBlackhole1(true) end
startBlackhole2()
end
else
if bhRunning then stopBlackhole1() end
if bh2Running then stopBlackhole2() end
end
end

-- 兼容5.txt/9.txt里悬浮窗关闭按钮的回调（它们会调用 _G.HyggUI.toggleBlackhole / toggleBH2）
_G.HyggUI = _G.HyggUI or {}
_G.HyggUI.toggleBlackhole = function(val)
if not val then stopBlackhole1() end
if bhToggleControl then pcall(function() bhToggleControl:Set(false) end) end
end
_G.HyggUI.toggleBH2 = function(val)
if not val then stopBlackhole2() end
if bhToggleControl then pcall(function() bhToggleControl:Set(false) end) end
end

local section = blackholeTab:Section({
Title = "黑洞",
Box = true,
})
section:Dropdown({
Title = "选择黑洞",
Values = {"黑洞1", "黑洞2"},
Value = "黑洞1",
Callback = function(selected)
selectedBlackhole = selected
if bhRunning or bh2Running then
toggleBlackhole(true)
end
end,
})
bhToggleControl = section:Toggle({
Title = "开关",
Value = false,
Callback = function(val) toggleBlackhole(val) end,
})

return blackholeTab

end
